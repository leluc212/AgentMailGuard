# Line endings (task 7.23). Every text file is LF in the working tree on every OS, so a clone on
# Windows gives the same bytes as one on Linux: shell scripts, Makefiles and the files the pinned
# inputs are hashed from keep working under WSL. Set `git config core.autocrlf input` as well;
# this file wins over it for the paths below.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.joblib binary
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary

# Byte-exact: the MIME fixtures carry CRLF on purpose (RFC 5322 line endings and legacy charsets),
# and the result tables are written by Python's csv module, which ends rows with CRLF.
tests/fixtures/mime/*.eml -text
evaluation/results/**/*.csv -text
