# ---------------------------------------------------------------------------
# AgentMailGuard — environment configuration template (guard v3 keys)
# All keys are read by mailguard/config/settings.py (pydantic-settings, "__" nesting)
# v2 keys (L1__* … L5__*, L3B__*, GUARD_MODELS__JUDGE|EXTRACTOR|DOC_SCANNER) stop the
# process with LegacyConfigError naming the v3 key (ADR-0015).
# ---------------------------------------------------------------------------
ENVIRONMENT=development
MAILGUARD__ENABLED=true
MAILGUARD__FAIL_CLOSED=true            # on internal error → BLOCK/quarantine, never silently pass

# --- LLM backends for the three evaluated models ---------------------------
# Local (Ollama): Qwen2.5-7B-Instruct, Llama-3.1-8B-Instruct
OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__TIMEOUT_S=60
# Remote (OpenAI API): GPT-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Which model backs each LLM-based guard stage (see configs/models.yaml)
GUARD_MODELS__INBOUND_JUDGE=qwen2.5-7b-instruct      # qwen2.5-7b-instruct | llama-3.1-8b-instruct | gpt-4o-mini | fake
GUARD_MODELS__INBOUND_EXTRACTOR=qwen2.5-7b-instruct
GUARD_MODELS__DOC_JUDGE=qwen2.5-7b-instruct
GUARD_MODELS__DOC_SET_JUDGE=fake                     # not used yet (guard v3 Task 10)
GUARD_MODELS__OUTPUT_JUDGE=qwen2.5-7b-instruct
GUARD_MODELS__MODELS_PATH=configs/models.yaml

# --- L1 Inbound Guard (scan + extract) -------------------------------------
INBOUND_GUARD__RULES_PATH=configs/injection_rules.yaml
INBOUND_GUARD__ML_MODEL_PATH=artifacts/models/l1_injection_clf_v1.joblib
INBOUND_GUARD__RULE_CONFIDENCE_THRESHOLD=0.90
INBOUND_GUARD__ML_CONFIDENCE_THRESHOLD=0.80
INBOUND_GUARD__SCAN_LLM_ENABLED=true
INBOUND_GUARD__BLOCK_THRESHOLD=0.85          # score >= → HIGH severity
INBOUND_GUARD__FLAG_THRESHOLD=0.50           # score >= → MEDIUM severity
INBOUND_GUARD__MAX_CHARS=12000
INBOUND_GUARD__EXTRACT_LLM_ENABLED=true
INBOUND_GUARD__MAX_BODY_CHARS=6000
INBOUND_GUARD__STRIP_THRESHOLD=0.50

# --- Channel Isolation (prompt building) -----------------------------------
CHANNEL_ISOLATION__SPOTLIGHTING_MODE=datamark    # delimit | datamark | encode
CHANNEL_ISOLATION__DATAMARK_CHAR=^
CHANNEL_ISOLATION__CHANNELS_PATH=configs/channels.yaml
CHANNEL_ISOLATION__MAX_UNTRUSTED_TOKENS=6000

# --- L2 Doc Scanner --------------------------------------------------------
DOC_SCANNER__QUARANTINE_THRESHOLD=0.70
DOC_SCANNER__LLM_ENABLED=false            # rules+ML by default (latency budget); LLM for high-risk tenants
DOC_SCANNER__MAX_QUARANTINE_RATIO=0.60

# --- L4 Output Guard -------------------------------------------------------
OUTPUT_GUARD__PII_PATTERNS_PATH=configs/pii_patterns.yaml
OUTPUT_GUARD__REDACT_PII=true
OUTPUT_GUARD__SYSTEM_PROMPT_LEAK_NGRAM=8
OUTPUT_GUARD__LLM_ENABLED=false

# --- Policy engine (L3 Inbound Gate / L4 decision) -------------------------
POLICY__POLICY_PATH=configs/policy.yaml
POLICY__AUDIT_LOG_PATH=logs/mailguard_audit.jsonl

# --- Observability ---------------------------------------------------------
TELEMETRY__PROMETHEUS_ENABLED=true
TELEMETRY__METRICS_PORT=9101
