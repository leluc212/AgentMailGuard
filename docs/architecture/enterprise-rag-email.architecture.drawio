        <mxCell id="card_principles" value="&lt;b style=&quot;font-size:12px;color:#0891b2;&quot;&gt;System Principles &amp;amp; Cost Defense&lt;/b&gt;&lt;span style=&quot;float:right;font-size:9px;color:#94a3b8;&quot;&gt;[Cyan &amp;middot; Cost Guard]&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #e2e8f0;&quot;/&gt;&lt;ul style=&quot;margin:4px 0 0 16px;padding:0;font-size:11px;color:#334155;line-height:1.4;&quot;&gt;&lt;li&gt;&lt;b&gt;Classify first &amp;middot; Retrieve only when required &amp;middot; Generate only when necessary&lt;/b&gt;&lt;/li&gt;&lt;li&gt;45% early exit (&lt;code&gt;reply_required=false&lt;/code&gt;); 100k daily &amp;rarr; 45k no-reply &amp;rarr; 20k simple &amp;rarr; 35k AI (~24.5k RAG)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;arcSize=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="645" height="125" as="geometry" />
        </mxCell>
        <mxCell id="card_rag_storage" value="&lt;b style=&quot;font-size:12px;color:#059669;&quot;&gt;Hybrid RAG, Business Data &amp;amp; Storage&lt;/b&gt;&lt;span style=&quot;float:right;font-size:9px;color:#94a3b8;&quot;&gt;[Emerald &amp;middot; Data Tier]&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #e2e8f0;&quot;/&gt;&lt;ul style=&quot;margin:4px 0 0 16px;padding:0;font-size:11px;color:#334155;line-height:1.4;&quot;&gt;&lt;li&gt;&lt;b&gt;Dual Search:&lt;/b&gt; PostgreSQL FTS (top 20) + pgvector HNSW (top 20) &amp;rarr; RRF &amp;rarr; Cross-Encoder Top 4&amp;ndash;6&lt;/li&gt;&lt;li&gt;&lt;b&gt;Context &amp;amp; Storage:&lt;/b&gt; Compressed thread state + Business data; MinIO/S3 stores raw MIME &amp;amp; attachments&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;arcSize=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="710" y="480" width="635" height="125" as="geometry" />
        </mxCell>
        <mxCell id="card_lifecycle_rel" value="&lt;b style=&quot;font-size:12px;color:#7c3aed;&quot;&gt;Lifecycle, Reliability &amp;amp; Observability&lt;/b&gt;&lt;span style=&quot;float:right;font-size:9px;color:#94a3b8;&quot;&gt;[Violet &amp;middot; State &amp;amp; Resilience]&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #e2e8f0;&quot;/&gt;&lt;ul style=&quot;margin:4px 0 0 16px;padding:0;font-size:11px;color:#334155;line-height:1.4;&quot;&gt;&lt;li&gt;&lt;b&gt;State Machine:&lt;/b&gt; RECEIVED &amp;rarr; NORMALIZED &amp;rarr; CLASSIFIED &amp;rarr; QUEUED &amp;rarr; CONTEXT_READY &amp;rarr; GENERATING &amp;rarr; DRAFTED &amp;rarr; COMPLETED&lt;/li&gt;&lt;li&gt;&lt;b&gt;Delivery:&lt;/b&gt; At-least-once + idempotent (org, mailbox, msg_id, op); backoff retries; exhausted &amp;rarr; DEAD_LETTER; OTel&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;arcSize=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="645" height="125" as="geometry" />
        </mxCell>
        <mxCell id="card_deployment_ops" value="&lt;b style=&quot;font-size:12px;color:#d97706;&quot;&gt;Deployment &amp;amp; Runtime Model&lt;/b&gt;&lt;span style=&quot;float:right;font-size:9px;color:#94a3b8;&quot;&gt;[Amber &amp;middot; Infrastructure]&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #e2e8f0;&quot;/&gt;&lt;ul style=&quot;margin:4px 0 0 16px;padding:0;font-size:11px;color:#334155;line-height:1.4;&quot;&gt;&lt;li&gt;&lt;b&gt;FYP Implementation:&lt;/b&gt; Docker Compose (FastAPI, PostgreSQL+pgvector, RabbitMQ, MinIO, Prometheus, Grafana)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Enterprise:&lt;/b&gt; Stateless worker pools, RabbitMQ cluster, managed DB, S3; scale on queue depth; interchangeable LLMs&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;arcSize=6;shadow=0;" vertex="1" parent="1">
