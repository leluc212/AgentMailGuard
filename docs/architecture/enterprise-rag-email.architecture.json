  "cards": [
    {
      "dot": "cyan",
      "title": "System Principles & Cost Defense",
      "items": [
        "Classify first \u00b7 Retrieve only when required \u00b7 Generate only when necessary",
        "45% early exit (reply_required=false); 100k daily \u2192 45k no-reply \u2192 20k simple \u2192 35k AI (~24.5k RAG)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hybrid RAG, Business Data & Storage",
      "items": [
        "Dual Search: PostgreSQL FTS (top 20) + pgvector HNSW (top 20) \u2192 RRF \u2192 Cross-Encoder Top 4\u20136",
        "Context & Storage: Compressed thread state + Business data; MinIO/S3 stores raw MIME, attachments & docs"
      ]
    },
    {
      "dot": "violet",
      "title": "Lifecycle, Reliability & Observability",
      "items": [
        "State Machine: RECEIVED \u2192 NORMALIZED \u2192 CLASSIFIED \u2192 QUEUED \u2192 CONTEXT_READY \u2192 GENERATING \u2192 DRAFTED \u2192 DISPATCHED \u2192 COMPLETED",
        "Delivery: at-least-once + idempotent (org, mailbox, msg_id, op); GENERATING \u2192 RETRY_PENDING \u2192 GENERATING (backoff); exhausted \u2192 DEAD_LETTER; OTel"
      ]
    },
    {
      "dot": "amber",
      "title": "Deployment & Runtime Model",
      "items": [
        "FYP Implementation: Docker Compose (FastAPI, PostgreSQL+pgvector, RabbitMQ, MinIO, Prometheus, Grafana)",
        "Enterprise: stateless worker pools, RabbitMQ cluster, managed DB, S3 storage; scale on queue depth; interchangeable AI"
      ]
    }
  ]
