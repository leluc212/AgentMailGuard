{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/runtime-feature-falsifier/attempt-batch.schema.json",
  "title": "Runtime Feature Falsifier Attempt Batch",
  "type": "object",
  "required": ["schema_version", "phase", "attempts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"enum": ["START", "FINISH"]},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
