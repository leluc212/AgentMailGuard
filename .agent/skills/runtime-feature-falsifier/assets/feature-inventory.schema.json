{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/runtime-feature-falsifier/feature-inventory.schema.json",
  "title": "Runtime Feature Falsifier System Feature Inventory",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "discovery_status",
    "discovery_sources",
    "workflow_coverage",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "discovery_status": {
      "enum": [
        "IN_PROGRESS",
        "COMPLETE",
        "PARTIAL_BLOCKED"
      ]
    },
    "discovery_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "location"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "discovery_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflow_coverage": {
      "type": "object",
      "required": [
        "applicable"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "kind",
          "claim",
          "claim_sources",
          "surfaces",
          "disposition"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "kind": {
            "enum": [
              "CAPABILITY",
              "FUNCTION",
              "WORKFLOW",
              "SYSTEM"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "claim_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "enum": [
              "IN_SCOPE",
              "EXCLUDED"
            ]
          },
          "exclusion_reason": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "exclusion_basis": {
            "enum": [
              "USER_SCOPE",
              "NOT_RUNTIME_CAPABILITY",
              "DUPLICATE_ALIAS",
              "OUTSIDE_TARGET_SYSTEM"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
