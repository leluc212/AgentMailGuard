# -----------------------------------------------------------------------------
# Enterprise RAG-Based Intelligent Email Management and Response System
# Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# --- General System Settings ---
ENVIRONMENT=development
SERVICE_NAME=rag-email
DEBUG=false

# --- 1. Database Configuration (PostgreSQL + pgvector - R5.1) ---
# Host-side values: docker-compose publishes Postgres on 5433 and MinIO on 9010 (containers use 5432 / minio:9000).
DATABASE__HOST=localhost
DATABASE__PORT=5433
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__NAME=rag_email
DATABASE__POOL_MIN=5
DATABASE__POOL_MAX=20
DATABASE__SSL_MODE=prefer

# --- 2. Broker Configuration (RabbitMQ - R3.1, R3.8, R7.1) ---
BROKER__HOST=localhost
BROKER__PORT=5672
BROKER__USER=guest
BROKER__PASSWORD=guest
BROKER__VHOST=/
BROKER__EXCHANGE_MAIL_INGEST=mail.ingest
BROKER__EXCHANGE_EMAIL_PROCESS=email.process
BROKER__EXCHANGE_EMAIL_TRIAGE=email.triage
BROKER__EXCHANGE_EMAIL_ROUTE=email.route
BROKER__EXCHANGE_EMAIL_DISPATCH=email.dispatch
BROKER__EXCHANGE_KNOWLEDGE_INGEST=knowledge.ingest
BROKER__EXCHANGE_RETRY=retry.email
BROKER__EXCHANGE_DLX=dlx.email
BROKER__EXCHANGE_RETRY_RETURN=retry.return
BROKER__QUEUE_MAIL_SYNC=mail.sync.requested
BROKER__QUEUE_NORMALIZE=email.normalize
BROKER__QUEUE_TRIAGE=email.triage
BROKER__QUEUE_DISPATCH=email.dispatch
BROKER__QUEUE_KNOWLEDGE=knowledge.ingest
BROKER__QUEUE_DEAD_LETTER=email.dead_letter
BROKER__USE_QUORUM_QUEUES=false

# --- 3. Object Storage Configuration (MinIO / S3 - R5.8) ---
OBJECT_STORAGE__ENDPOINT=localhost:9010
OBJECT_STORAGE__ACCESS_KEY=minioadmin
OBJECT_STORAGE__SECRET_KEY=minioadmin
OBJECT_STORAGE__BUCKET_RAW_MIME=raw-mime
OBJECT_STORAGE__BUCKET_ATTACHMENTS=attachments
OBJECT_STORAGE__BUCKET_KNOWLEDGE=knowledge-docs
# HTML part of a message (R4.1); `storage_cli bootstrap` creates it with the other buckets.
# Docker Compose forwards no bucket names: the containers use these defaults.
OBJECT_STORAGE__BUCKET_HTML=html
OBJECT_STORAGE__SECURE=false
OBJECT_STORAGE__REGION=us-east-1

# --- 4. Provider Credential References (R1.1 - Secrets stored by reference only) ---
PROVIDERS__MOCK_PROVIDERS=true
PROVIDERS__GMAIL_CREDENTIALS_REF=vault/gmail
PROVIDERS__GRAPH_CREDENTIALS_REF=vault/graph
PROVIDERS__IMAP_CREDENTIALS_REF=vault/imap

# --- 5. Embedding Model & Dimension (R5.10, R9.6, R9.11) ---
EMBEDDING__MODEL_NAME=text-embedding-3-small
EMBEDDING__DIMENSION=1536
EMBEDDING__BATCH_SIZE=64
EMBEDDING__MAX_TOKENS=8191
EMBEDDING__BASE_URL=https://api.openai.com/v1
EMBEDDING__API_KEY=
EMBEDDING__MOCK=true
EMBEDDING__TIMEOUT_S=10.0
EMBEDDING__MAX_RETRIES=3
EMBEDDING__RETRY_DELAY_S=0.5
#
# Gemini embeddings for the live benchmark (task 7.20, docs/demo-runbook.md section 9.9): one
# model and one dimension for every run, so the corpus and the queries match (R5.10).
# gemini-embedding-001 returns 3072 numbers unless asked for fewer; EMBEDDING__DIMENSION above
# (1536) is sent with every request and is the width of the vector column. The key is the same
# Google AI Studio key as LLM__OPENAI_API_KEY. Host tools read these lines from .env; the
# containers get them from .env.stack, rendered per model by
# `python -m evaluation.mailguard_bench.live.stack_env` and never written to a tracked file.
# EMBEDDING__MOCK=false
# EMBEDDING__MODEL_NAME=gemini-embedding-001
# EMBEDDING__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING__API_KEY=<Gemini API key from Google AI Studio>

# --- 6. LLM Configuration, Tiers & Ablation Flags (R14.5, R14.7, R15.1, R15.6, R20.6, R21.6, R24.5) ---
LLM__PROVIDER=fake
LLM__FAST_MODEL=gpt-4o-mini
LLM__STRONG_MODEL=gpt-4o
LLM__FALLBACK_MODEL=claude-3-haiku
LLM__FORCE_SINGLE_TIER=false
# Per-call LLM timeout. Docker Compose forwards it when set; the live benchmark's stack env
# (task 7.20) gives the containers 60, the timeout the v1 benchmark used.
LLM__TIMEOUT_S=15.0
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=https://api.openai.com/v1
LLM__ANTHROPIC_API_KEY=
LLM__ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# LLM__PRICE_TABLE replaces the whole per-model price table (USD per 1M tokens). A model
# missing from it stores cost_estimate = NULL (unknown), never 0. Example:
# LLM__PRICE_TABLE={"gpt-4o-mini":{"input_per_m":0.15,"output_per_m":0.60},"gpt-4o":{"input_per_m":5.0,"output_per_m":15.0}}
LLM__LOCAL_BASE_URL=http://localhost:11434/v1
LLM__LOCAL_API_KEY=ollama
#
# OpenRouter route of the benchmark (work package R4, parked; docs/demo-runbook.md section 9.10).
# Qwen2.5-7B and Llama-3.1-8B through OpenRouter's API with ONE provider pinned and fallbacks off.
# Do not set the two LLM__ lines by hand: the model profiles qwen2.5-7b-openrouter and
# llama-3.1-8b-openrouter (evaluation/mailguard_bench/model_profiles.py) render them, for the host
# processes at run time and for the containers into .env.stack. They are shown so the format is
# known. A pin needs the metadata switch (settings validation refuses one without it); leave both
# unset when not routing, and never write them as `NAME=` (Compose would forward a blank).
# LLM__OPENAI_PROVIDER_ROUTING={"order":["coreweave"],"allow_fallbacks":false,"require_parameters":true,"quantizations":["bf16"]}
# LLM__OPENAI_RESPONSE_METADATA=true
# The two keys below are read by the profiles only (like BENCH_OPENAI_API_KEY): the OpenRouter key
# and, optionally, another base URL (default https://openrouter.ai/api/v1).
# BENCH_OPENROUTER_API_KEY=<your OpenRouter key>
# BENCH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Google Gemini API through its OpenAI-compatible endpoint (the project's live runs, task 5.0).
# Docker Compose forwards LLM__OPENAI_BASE_URL, the three model names and LLM__PRICE_TABLE into
# the app containers; a blank value keeps the settings default. With LLM__PROVIDER=openai, a
# Gemini/Gemma model on the default OpenAI base URL fails settings validation at startup, so
# the key is never sent to api.openai.com (R20.6). Gemma is free of charge (free tier only);
# gemini-3.1-flash-lite costs $0.25 / $1.50 per 1M input / output tokens (Google pricing page,
# updated 2026-09-24) (R21.6). Check the configuration live with `make llm-smoke`.
# LLM__PROVIDER=openai
# LLM__OPENAI_API_KEY=<Gemini API key from Google AI Studio>
# LLM__OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM__FAST_MODEL=gemma-4-26b-a4b-it
# LLM__STRONG_MODEL=gemma-4-31b-it
# LLM__FALLBACK_MODEL=gemini-3.1-flash-lite
# LLM__PRICE_TABLE={"gemma-4-26b-a4b-it":{"input_per_m":0,"output_per_m":0},"gemma-4-31b-it":{"input_per_m":0,"output_per_m":0},"gemini-3.1-flash-lite":{"input_per_m":0.25,"output_per_m":1.50},"text-embedding-3-small":{"input_per_m":0.02,"output_per_m":0}}

# --- 7. Hybrid Retrieval Parameters (R10, R11) ---
RETRIEVAL__TOP_N=20
RETRIEVAL__RRF_K=60
RETRIEVAL__TOP_K=5
# Cross-encoder reranking of the fused candidates (R11.1, R11.2, R11.5); the ai-worker honours
# RERANK_ENABLED. The runtime image carries the model (downloaded at build time, no network at
# runtime) and sets RERANK_MODEL_DIR itself; Compose never forwards it, so a value here reaches
# host processes only, and empty means the Hugging Face cache (a host run). Unavailable or slower than
# RERANK_TIMEOUT_MS: the RRF order is kept and the fallback is recorded.
RETRIEVAL__RERANK_ENABLED=true
RETRIEVAL__RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL__RERANK_MODEL_DIR=
RETRIEVAL__RERANK_TIMEOUT_MS=1000
RETRIEVAL__RELEVANCE_FLOOR=0.70
# The vector branch spends this on the query embedding plus the ANN search (R10.9). 3000 leaves
# room for a hosted embedding call; with 500 it could run out and degrade retrieval to lexical.
RETRIEVAL__RETRIEVAL_TIMEOUT_MS=3000
# Filter retrieval by the category triage assigned (R10.4, R12.4; ADR-0013). true, the default,
# is production's behaviour: only documents filed under that category are searched. The live
# benchmark (task 7.20, docs/demo-runbook.md section 9.9) needs false for every run: its case
# documents are filed under the case's own category, which live triage does not always choose, so
# the filter would hide them. The organization and status filters stay. Docker Compose forwards
# it when set; host tools read it from .env, and the benchmark's stack env gives the containers
# false.
RETRIEVAL__CATEGORY_FILTER_ENABLED=true
# RETRIEVAL__CATEGORY_FILTER_ENABLED=false

# --- 8. Cascading Triage Thresholds (R6.1, R6.2, R6.11) ---
TRIAGE__RULE_CONFIDENCE_THRESHOLD=0.95
TRIAGE__ML_CONFIDENCE_THRESHOLD=0.80
TRIAGE__LLM_CONFIDENCE_THRESHOLD=0.70
TRIAGE__SAFE_DEFAULT_CATEGORY=general_inquiry
TRIAGE__SAFE_DEFAULT_PRIORITY=normal
TRIAGE__RULES_PATH=config/triage_rules.yaml
TRIAGE__ML_MODEL_PATH=artifacts/models/triage_ml_v1.joblib
TRIAGE__TEMPLATES_PATH=config/templates.yaml
# Category retrieval floor (R6.6, R12.4; design.md section 5.3, ADR-0013). true: a reply routed to
# AI generation retrieves when its category's default_retrieval_required (config/categories.yaml)
# is true, even if the triage stage said false; false keeps each stage's own answer. Docker
# Compose forwards it to the triage-worker when set.
TRIAGE__CATEGORY_RETRIEVAL_FLOOR=true

# --- 9. Thread Summarization Thresholds (R8.3, R8.4) ---
SUMMARIZATION__MIN_MESSAGES_THRESHOLD=4
SUMMARIZATION__CONTEXT_TOKEN_THRESHOLD=1500
SUMMARIZATION__KEEP_LATEST_MESSAGES=2
SUMMARIZATION__RESUMMARIZE_LAG_MESSAGES=2
# Model for thread summaries (R8.3), honoured when set. Unset: the FAST tier model
# (LLM__FAST_MODEL) writes them. Name only a model that the configured LLM__PROVIDER endpoint
# serves: a model from another provider fails every summary. An .env copied from this file before
# task 7.20 has `SUMMARIZATION__SUMMARIZER_MODEL=gpt-4o-mini` here: delete that line. Docker
# Compose never reads this name from .env, so the containers are safe either way; it reaches the
# containers only as BENCH_SUMMARIZER_MODEL, which the live benchmark's stack env sets to the
# benchmarked model. Host processes (the benchmark's guard-worker) do read this line.
# SUMMARIZATION__SUMMARIZER_MODEL=

# --- 10. Message Queue Retry Ladder (R3.4, R19.5 - TTL + DLX, Backoff & Jitter) ---
RETRY__TIER_1_DELAY_S=30
RETRY__TIER_2_DELAY_S=300
RETRY__TIER_3_DELAY_S=1800
RETRY__MAX_RETRIES=3
RETRY__BACKOFF_BASE_S=1.0
RETRY__BACKOFF_FACTOR=2.0
RETRY__MAX_BACKOFF_S=1800.0
RETRY__JITTER_MODE=full

# --- 11. Worker Prefetch & Concurrency (R20.3, R7.2) ---
CONCURRENCY__DEFAULT_PREFETCH=10
CONCURRENCY__MAIL_CONNECTOR_CONCURRENCY=5
CONCURRENCY__EMAIL_WORKER_CONCURRENCY=10
CONCURRENCY__TRIAGE_WORKER_CONCURRENCY=10
CONCURRENCY__AI_WORKER_CONCURRENCY=4
CONCURRENCY__AI_WORKER_NORMAL_CONCURRENCY=4
CONCURRENCY__AI_WORKER_PRIORITY_CONCURRENCY=8
CONCURRENCY__AI_WORKER_NORMAL_PREFETCH=10
CONCURRENCY__AI_WORKER_PRIORITY_PREFETCH=5
CONCURRENCY__KNOWLEDGE_WORKER_CONCURRENCY=2
CONCURRENCY__DISPATCH_WORKER_CONCURRENCY=5
CONCURRENCY__MICRO_BATCH_SIZE=5
CONCURRENCY__MICRO_BATCH_TIMEOUT_MS=50

# --- 12. Observability & Telemetry (R21, R20.7, R20.8) ---
TELEMETRY__LOG_LEVEL=INFO
TELEMETRY__LOG_FORMAT=json
TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
TELEMETRY__PROMETHEUS_ENABLED=true
TELEMETRY__METRICS_PORT=9090
TELEMETRY__HEALTH_PORT=8080
TELEMETRY__DRAIN_TIMEOUT_S=15.0

# --- 13. REST API Configuration (R23.1, R23.6) ---
API__SERVICE_NAME=api
API__API_PREFIX=/v1
API__HOST=0.0.0.0
API__PORT=8000
API__CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
API__TITLE="Enterprise RAG Email API"
API__VERSION="0.1.0"

# --- 14. Subscription Renewal Job (R2.10) ---
SUBSCRIPTION_RENEWAL__RENEWAL_THRESHOLD_HOURS=24
SUBSCRIPTION_RENEWAL__CHECK_INTERVAL_SECONDS=3600
SUBSCRIPTION_RENEWAL__BATCH_SIZE=100

# --- 15. Thread Association (R4.6, design.md §5.2) ---
THREAD_ASSOCIATION__WINDOW_DAYS=14

# --- 16. Category Routing & Priority Lanes (R7.1, R7.2, R7.4, R7.6) ---
ROUTING__CATEGORIES_CONFIG_PATH=config/categories.yaml
ROUTING__PRIORITY_LANES=["normal","priority"]
# Which lane queues have a consumer (R7.6). Leave it unset: the default is derived from the
# category taxonomy (every category in config/categories.yaml and the canonical nine, on every
# lane in ROUTING__PRIORITY_LANES), so no lane is left without a consumer and a category you add
# is consumed at once (packages/broker/routing.py resolve_configured_consumers). The ai-worker
# container runs that default, because Docker Compose forwards no ROUTING__* value. A
# value here reaches host processes only, and the live benchmark's guard-worker and runner would
# then consume other lanes than the ai-worker container does (an .env copied before task 7.20 has
# a list without email.administration.priority here: delete it). stack_env refuses such an .env.
# ROUTING__CONFIGURED_CONSUMERS=

# --- 17. Lease Reaper (R19.8, design.md §9) ---
LEASE_REAPER__ENABLED=false
LEASE_REAPER__LEASE_TIMEOUT_S=300
LEASE_REAPER__REAPER_INTERVAL_S=30.0
LEASE_REAPER__BATCH_SIZE=100
LEASE_REAPER__REAP_STUCK_UNLEASED=true

# --- 18. Agent Profile Registry (R14.1, R14.2, R14.6) ---
AGENT_PROFILES__CONFIG_PATH=config/agent_profiles.yaml
AGENT_PROFILES__DEFAULT_PROFILE=general_inquiry
AGENT_PROFILES__PROMPTS_DIR=prompts
AGENT_PROFILES__SCHEMAS_DIR=schemas

# --- 19. Complexity Router & Model Cascade (R15.1, R15.6, design.md §5.7) ---
ROUTER_ENABLED=true
ROUTER_FORCE_SINGLE_TIER=false
ROUTER_DEFAULT_TIER=routine
ROUTER_ESCALATED_TIER=high_capability
ROUTER_CONFIDENCE_THRESHOLD=0.75
ROUTER_THREAD_MESSAGES_THRESHOLD=5
ROUTER_THREAD_TOKENS_THRESHOLD=2000
ROUTER_MIN_RETRIEVED_CHUNKS=2
# Applied only when the cross-encoder rerank ran; without it only ROUTER_MIN_RETRIEVED_CHUNKS counts (task 7.21).
ROUTER_MIN_RELEVANCE_SCORE=0.50
ROUTER_MULTIPLE_ACTIONS_THRESHOLD=2
ROUTER_CONTEXT_TOKENS_THRESHOLD=3500
ROUTER_MAX_ESCALATIONS_PER_JOB=1
ROUTER_SINGLE_TIER_OVERRIDE=high_capability

# --- 20. Business Data Lookups (R13.4, R13.7, design.md §5.4, ADR-0008) ---
BUSINESS_DATA__TIMEOUT_MS=500
BUSINESS_DATA__SNAPSHOT_ORDERS=3
BUSINESS_DATA__SNAPSHOT_TICKETS=3

# --- 21. Review UI (R23.4, R23.5, R23.6, R23.7, design.md §5.8, ADR-0009) ---
# Local use only: compose publishes the UI (3001) and the API (8000) on 127.0.0.1; there is
# no login. Inside compose the UI reaches the API at http://api:8000 (docker-compose.yml);
# FRONTEND__API_BASE_URL here is used when the UI runs on the host.
FRONTEND__API_BASE_URL=http://localhost:8000
# Tenant whose drafts the UI reviews (sent as X-Organization-Id): the seeded demo tenant.
FRONTEND__ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# --- 22. Live Gmail test mailbox (R17.1, task 6.10, docs/demo-runbook.md §3) ---
# Short-lived OAuth access token (scope gmail.modify) for the owner-run live demo and
# make phase6-gate. Leave blank for offline use and CI: tests strip it (R24.5). Compose
# forwards it to mail-connector and dispatch-worker only. The stack never refreshes it.
# For the gate, set billing's dispatch_mode to send_reply in config/categories.yaml
# (dispatch_mode is a per-category YAML key, not an env var; default create_draft, task 6.4).
GMAIL_ACCESS_TOKEN=
