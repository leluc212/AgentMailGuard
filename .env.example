# ---------------------------------------------------------------------------
# AgentMailGuard — environment configuration template
# All keys are read by mailguard/config/settings.py (pydantic-settings, "__" nesting)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
MAILGUARD__ENABLED=true
MAILGUARD__FAIL_CLOSED=true            # on internal error → BLOCK/quarantine, never silently pass

# --- LLM backends for the three evaluated models ---------------------------
# Local (Ollama): Qwen2.5-7B-Instruct, Llama-3.1-8B-Instruct
OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__TIMEOUT_S=60
# Remote (OpenAI API): GPT-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Which model backs each LLM-based guard stage (see configs/models.yaml)
GUARD_MODELS__JUDGE=qwen2.5-7b-instruct        # qwen2.5-7b-instruct | llama-3.1-8b-instruct | gpt-4o-mini | fake
GUARD_MODELS__EXTRACTOR=qwen2.5-7b-instruct
GUARD_MODELS__DOC_SCANNER=qwen2.5-7b-instruct
GUARD_MODELS__OUTPUT_JUDGE=qwen2.5-7b-instruct

# --- Layer 1: Email Injection Scanner --------------------------------------
L1__RULES_PATH=configs/injection_rules.yaml
L1__ML_MODEL_PATH=artifacts/models/l1_injection_clf_v1.joblib
L1__RULE_CONFIDENCE_THRESHOLD=0.90
L1__ML_CONFIDENCE_THRESHOLD=0.80
L1__LLM_ENABLED=true
L1__BLOCK_THRESHOLD=0.85          # score >= → HIGH severity
L1__FLAG_THRESHOLD=0.50           # score >= → MEDIUM severity

# --- Layer 2: User Intent Extractor ----------------------------------------
L2__LLM_ENABLED=true
L2__MAX_BODY_CHARS=6000

# --- Layer 3: Channel Isolation --------------------------------------------
L3__SPOTLIGHTING_MODE=datamark    # delimit | datamark | encode
L3__DATAMARK_CHAR=^
L3__CHANNELS_PATH=configs/channels.yaml

# --- Layer 3b: Retrieved Document Scanner ----------------------------------
L3B__QUARANTINE_THRESHOLD=0.70
L3B__LLM_ENABLED=false            # rules+ML by default (latency budget); LLM for high-risk tenants

# --- Layer 4: Output Scanner -----------------------------------------------
L4__PII_PATTERNS_PATH=configs/pii_patterns.yaml
L4__REDACT_PII=true
L4__SYSTEM_PROMPT_LEAK_NGRAM=8
L4__LLM_ENABLED=false

# --- Layer 5: Email Policy Engine ------------------------------------------
L5__POLICY_PATH=configs/policy.yaml
L5__AUDIT_LOG_PATH=logs/mailguard_audit.jsonl

# --- Observability ---------------------------------------------------------
TELEMETRY__PROMETHEUS_ENABLED=true
TELEMETRY__METRICS_PORT=9101
